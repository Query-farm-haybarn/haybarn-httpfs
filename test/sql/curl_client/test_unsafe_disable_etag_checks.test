# name: test/sql/curl_client/test_unsafe_disable_etag_checks.test
# description: With unsafe_disable_etag_checks=true the client must not send
# group: [curl_client]

#              If-Range or If-Match, and a mutated remote file is read without
#              error (caller has explicitly opted out of consistency checks).

require httpfs

require-env COMPRESSION_TEST_SERVER_URL

require-env COMPRESSION_TEST_SERVER_DIR

statement ok
COPY (SELECT i AS v FROM range(0, 50) tbl(i))
TO '${COMPRESSION_TEST_SERVER_DIR}/disable_seed.csv' (HEADER);

statement ok
SET httpfs_client_implementation='curl';

statement ok
SET unsafe_disable_etag_checks=true;

query I
SELECT count(*) FROM '${COMPRESSION_TEST_SERVER_URL}/conditional/disable_seed.csv';
----
50

statement ok
SELECT length(content) FROM read_text('${COMPRESSION_TEST_SERVER_URL}/mutate/disable_seed.csv');

# Without conditional headers the second read just reads whatever the server
# currently serves. The mutated representation parses as a CSV with the same
# leading rows plus the appended "[generation 1]" line.
query I
SELECT count(*) > 0 FROM '${COMPRESSION_TEST_SERVER_URL}/conditional/disable_seed.csv';
----
true
