# name: test/sql/curl_client/test_if_range_fallback_to_last_modified.test
# description: When only a weak ETag is cached, If-Range falls back to using
# group: [curl_client]

#              Last-Modified as the validator. A real mid-read mutation must
#              still be detected — the server bumps Last-Modified on mutation,
#              the client's stale Last-Modified value no longer matches, and
#              the server returns 200 instead of 206.

require httpfs

require-env COMPRESSION_TEST_SERVER_URL

require-env COMPRESSION_TEST_SERVER_DIR

statement ok
COPY (SELECT i AS v FROM range(0, 50) tbl(i))
TO '${COMPRESSION_TEST_SERVER_DIR}/weak_fallback_seed.csv' (HEADER);

statement ok
SET httpfs_client_implementation='curl';

# Initial read caches a weak ETag plus Last-Modified.
query I
SELECT count(*) FROM '${COMPRESSION_TEST_SERVER_URL}/weak_etag/weak_fallback_seed.csv';
----
50

statement ok
SELECT length(content) FROM read_text('${COMPRESSION_TEST_SERVER_URL}/mutate/weak_fallback_seed.csv');

# Subsequent read sends If-Range: <old Last-Modified> (since the ETag is weak
# and can't be used). Server's current Last-Modified is newer, so the
# precondition fails and we throw.
statement error
SELECT count(*) FROM '${COMPRESSION_TEST_SERVER_URL}/weak_etag/weak_fallback_seed.csv';
----
appears to have changed
